{
	"name": "femto-webmap",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=20.11"
	},
	"scripts": {
		"dev": "vite",
		"build": "pnpm run check && vite build",
		"check": "biome check . && tsc --noEmit && vitest run",
		"test": "vitest run",
		"lint": "biome check .",
		"format": "biome format --write ."
	},
	"dependencies": {
		"mapbox-gl": "^3.25.0",
		"maplibre-gl": "^5.24.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"typescript": "~6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	}
}
