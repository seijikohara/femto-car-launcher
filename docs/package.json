{
  "name": "femto-docs",
  "private": true,
  "type": "module",
  "description": "Project website for Femto Car Launcher: feature guide, install guide, legal pages and (from PR-3) the dashboard screenshot catalog. Published to GitHub Pages by .github/workflows/docs.yml.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-dist-links.ts",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit && prettier --check . && oxlint && vitest run",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "prettier --write .",
    "import-catalog": "node scripts/import-catalog.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "@base-ui/react": "^1.8.0",
    "astro": "^7.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "satteri": "^0.10.5",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/hast": "^3.0.4",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.4.2"
}
