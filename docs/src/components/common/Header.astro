---
import SiteHeader from "@/components/site/SiteHeader";
import { getEnabledNavItems, isNavItemActive } from "@/lib/nav";
import { withBase } from "@/lib/url";
import siteConfig from "@/site.config";
import logo from "../../../../logo.svg";

// currentPath includes the base, so isNavItemActive compares against
// base-prefixed hrefs/sections (withBase, passed in below).
const currentPath = Astro.url.pathname;

const items = getEnabledNavItems().map((item) => ({
    name: item.name,
    href: withBase(item.href),
    active: isNavItemActive(currentPath, item, withBase),
}));
---

{/* transition:persist keeps the island (and its React state) across client-side
    navigations; props still refresh per page, so the active item updates. */}
<SiteHeader
    client:load
    transition:persist
    brand={{ name: siteConfig.name, href: withBase("/"), logoSrc: logo.src }}
    items={items}
    showThemeToggle={siteConfig.theme.showThemeToggle}
/>
