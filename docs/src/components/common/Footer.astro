---
import siteConfig from "@/site.config";
import { withBase } from "@/lib/url";
import { getEnabledNavItems } from "@/lib/nav";

const currentYear = new Date().getFullYear();
const navItems = getEnabledNavItems();
---

<footer class="border-t border-border bg-muted/40">
    <div class="mx-auto grid w-full max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[2fr_1fr_1fr]">
        <div>
            <p class="text-lg font-semibold">{siteConfig.name}</p>
            <p class="mt-2 max-w-prose text-sm text-muted-foreground">
                {siteConfig.description}
            </p>
        </div>
        <div>
            <h2 class="text-sm font-semibold">Pages</h2>
            <ul class="mt-3 space-y-2 text-sm">
                {navItems.map((item) => (
                    <li>
                        <a
                            href={withBase(item.href)}
                            class="text-muted-foreground hover:text-foreground"
                        >
                            {item.name}
                        </a>
                    </li>
                ))}
            </ul>
        </div>
        <div>
            <h2 class="text-sm font-semibold">Project</h2>
            <ul class="mt-3 space-y-2 text-sm">
                {siteConfig.footer.links.map((link) => (
                    <li>
                        <a
                            href={withBase(link.href)}
                            class="text-muted-foreground hover:text-foreground"
                        >
                            {link.name}
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </div>
    <div class="mx-auto w-full max-w-6xl border-t border-border px-4 py-6 text-sm text-muted-foreground sm:px-6">
        © {currentYear} {siteConfig.name}. Licensed under the{" "}
        <a
            href={`${siteConfig.repository}/blob/main/LICENSE`}
            class="underline underline-offset-4 hover:text-foreground"
        >
            Apache License 2.0
        </a>
        .
    </div>
</footer>
