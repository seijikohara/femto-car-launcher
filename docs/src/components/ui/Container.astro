---
import { cn } from "cn";

export interface Props {
    size?: "sm" | "md" | "lg" | "xl" | "full";
    as?: keyof HTMLElementTagNameMap;
    class?: string;
}

const { size = "lg", as: Tag = "div", class: className = "" } = Astro.props;

const sizeMap: Record<string, string> = {
    sm: "max-w-3xl",
    md: "max-w-4xl",
    lg: "max-w-6xl",
    xl: "max-w-7xl",
    full: "max-w-none",
};
---

<Tag class={cn("mx-auto w-full px-4 sm:px-6", sizeMap[size], className)}>
    <slot />
</Tag>
