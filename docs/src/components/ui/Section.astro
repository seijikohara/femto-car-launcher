---
import Container from "./Container.astro";
import { cn } from "@/lib/utils";

export interface Props {
    id?: string;
    title?: string;
    subtitle?: string;
    eyebrow?: string;
    align?: "left" | "center";
    spacing?: "sm" | "md" | "lg";
    container?: "sm" | "md" | "lg" | "xl" | "full" | "none";
    class?: string;
}

const {
    id,
    title,
    subtitle,
    eyebrow,
    align = "center",
    spacing = "lg",
    container = "lg",
    class: className = "",
} = Astro.props;

const hasHeader = Boolean(eyebrow || title || subtitle);
---

<section
    id={id}
    class={cn(
        spacing === "sm"
            ? "py-12"
            : spacing === "md"
              ? "py-16"
              : "py-20 sm:py-24",
        className,
    )}
>
    {container === "none" ? (
        <Fragment>
            {hasHeader && (
                <div
                    class={cn(
                        "mb-10 max-w-2xl",
                        align === "center" && "mx-auto text-center",
                    )}
                >
                    {eyebrow && (
                        <p class="text-sm font-medium tracking-wide text-primary uppercase">
                            {eyebrow}
                        </p>
                    )}
                    {title && (
                        <h2 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
                            {title}
                        </h2>
                    )}
                    {subtitle && (
                        <p class="mt-4 text-lg text-muted-foreground">
                            {subtitle}
                        </p>
                    )}
                </div>
            )}
            <slot />
        </Fragment>
    ) : (
        <Container size={container}>
            {hasHeader && (
                <div
                    class={cn(
                        "mb-10 max-w-2xl",
                        align === "center" && "mx-auto text-center",
                    )}
                >
                    {eyebrow && (
                        <p class="text-sm font-medium tracking-wide text-primary uppercase">
                            {eyebrow}
                        </p>
                    )}
                    {title && (
                        <h2 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
                            {title}
                        </h2>
                    )}
                    {subtitle && (
                        <p class="mt-4 text-lg text-muted-foreground">
                            {subtitle}
                        </p>
                    )}
                </div>
            )}
            <slot />
        </Container>
    )}
</section>
