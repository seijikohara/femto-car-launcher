---
import { buttonVariants } from "@/components/ui/button";
import { classifyHref, withBase } from "@/lib/url";
import { cn } from "@/lib/utils";

export interface Props {
    href?: string;
    variant?: "solid" | "outline" | "ghost" | "link";
    size?: "sm" | "md" | "lg";
    type?: "button" | "submit" | "reset";
    fullWidth?: boolean;
    disabled?: boolean;
    // When omitted, external is auto-detected from `href` (absolute http(s)
    // URLs open in a new tab; anchors/relative paths don't). Pass explicitly
    // to override.
    external?: boolean;
    class?: string;
    "aria-label"?: string;
}

const {
    href,
    variant = "solid",
    size = "md",
    type = "button",
    fullWidth = false,
    disabled = false,
    external,
    class: className = "",
    "aria-label": ariaLabel,
    ...rest
} = Astro.props;

const isExternal =
    external ?? (href ? classifyHref(href) === "external" : false);

// aria-label replaces the accessible name computed from child content, so
// the visually-hidden "(opens in new tab)" span below would otherwise go
// unannounced whenever a caller also passes aria-label.
const resolvedAriaLabel =
    isExternal && ariaLabel ? `${ariaLabel} (opens in new tab)` : ariaLabel;

const Tag = href ? "a" : "button";

const variantMap = {
    solid: "default",
    outline: "outline",
    ghost: "ghost",
    link: "link",
} as const;
const sizeMap = { sm: "sm", md: "default", lg: "lg" } as const;
const classes = cn(
    buttonVariants({ variant: variantMap[variant], size: sizeMap[size] }),
    fullWidth && "w-full",
    className,
);
---

<Tag
    class={classes}
    href={href ? withBase(href) : undefined}
    type={href ? undefined : type}
    rel={isExternal ? "noopener noreferrer" : undefined}
    target={isExternal ? "_blank" : undefined}
    aria-disabled={href && disabled ? "true" : undefined}
    disabled={!href && disabled ? true : undefined}
    aria-label={resolvedAriaLabel}
    {...rest}
>
    <slot />
    {isExternal && <span class="sr-only"> (opens in new tab)</span>}
</Tag>
