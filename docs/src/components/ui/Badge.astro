---
import { badgeVariants } from "@/components/ui/badge";
import { cn } from "cn";

export interface Props {
    variant?: "default" | "secondary" | "outline";
    class?: string;
}

const { variant = "secondary", class: className = "" } = Astro.props;
---

<span class={cn(badgeVariants({ variant }), className)}>
    <slot />
</span>
