---
import BaseLayout from "./BaseLayout.astro";
import Header from "@/components/common/Header.astro";
import Footer from "@/components/common/Footer.astro";
import Container from "@/components/ui/Container.astro";

interface Props {
    title: string;
    description: string;
    eyebrow?: string;
    hideTitle?: boolean;
}

const { title, description, eyebrow, hideTitle = false } = Astro.props;
---

<BaseLayout title={title} description={description}>
    <Header />
    <main id="main" tabindex="-1" class="py-12 sm:py-16">
        <Container size="md">
            <article class="rounded-xl border border-border bg-card p-6 text-card-foreground shadow-sm sm:p-10">
                {!hideTitle && (
                    <header class="mb-10">
                        {eyebrow && (
                            <p class="text-sm font-medium tracking-wide text-primary uppercase">
                                {eyebrow}
                            </p>
                        )}
                        <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
                            {title}
                        </h1>
                        <p class="mt-4 text-lg text-muted-foreground">
                            {description}
                        </p>
                    </header>
                )}
                <div class="prose prose-neutral max-w-none dark:prose-invert prose-headings:scroll-mt-24 prose-a:underline-offset-4 prose-img:rounded-lg">
                    <slot />
                </div>
            </article>
        </Container>
    </main>
    <Footer />
</BaseLayout>
