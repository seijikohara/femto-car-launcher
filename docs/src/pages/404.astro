---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/common/Header.astro";
import Footer from "@/components/common/Footer.astro";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
---

<BaseLayout
    title="Page not found"
    description="The page you were looking for doesn't exist or has moved."
    noIndex={true}
>
    <Header />

    <main id="main" tabindex="-1" class="py-16">
        <Container size="md">
            <div class="rounded-xl border border-border bg-card p-8 text-center shadow-sm sm:p-12">
                <p
                    class="text-6xl font-semibold tracking-tight text-primary"
                    aria-hidden="true"
                >
                    404
                </p>
                <h1 class="mt-4 text-3xl font-semibold tracking-tight">
                    Page not found
                </h1>
                <p class="mt-3 text-muted-foreground">
                    The page you were looking for doesn't exist or may have
                    moved. Let's get you back on track.
                </p>
                <div class="mt-8">
                    <Button href="/" variant="solid">
                        Back to home
                    </Button>
                </div>
            </div>
        </Container>
    </main>

    <Footer />
</BaseLayout>
