---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/common/Header.astro";
import Footer from "@/components/common/Footer.astro";
import Container from "@/components/ui/Container.astro";
import CatalogViewer from "@/catalog/CatalogViewer";
import { withBase } from "@/lib/url";

const title = "Screenshot catalog";
const description =
    "The dashboard rendered for every display geometry, display size, theme, driver side and dock position — pick two axes to compare and filter the rest.";
---

<BaseLayout title={title} description={description}>
    <Header />
    <main id="main" tabindex="-1" class="py-12 sm:py-16">
        <Container size="full">
            <header class="mb-10 max-w-3xl">
                <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
                    {title}
                </h1>
                <p class="mt-4 text-lg text-muted-foreground">{description}</p>
                <p class="mt-3 text-sm text-muted-foreground">
                    Renders come from the same screenshot harness as the
                    goldens: the map is a still, the glass blur is not
                    rasterized, and fonts fall back to the system face. The page
                    URL reflects your selection, so a combination can be shared
                    as a link.
                </p>
            </header>
            <CatalogViewer
                client:load
                manifestUrl={withBase("/catalog/manifest.json")}
                assetBase={withBase("/catalog/")}
            />
        </Container>
    </main>
    <Footer />
</BaseLayout>
