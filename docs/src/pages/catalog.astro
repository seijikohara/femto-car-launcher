---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/common/Header.astro";
import Footer from "@/components/common/Footer.astro";
import Container from "@/components/ui/Container.astro";
import CatalogViewer from "@/catalog/CatalogViewer";
import { withBase } from "@/lib/url";

const title = "Screenshot catalog";
const description =
    "The dashboard rendered across display geometries, display sizes, themes, driver sides and dock positions. Pick two axes to compare and filter the rest.";
---

<BaseLayout title={title} description={description}>
    <Header />
    <main id="main" tabindex="-1" class="py-12 sm:py-16">
        <Container size="full">
            <header class="mb-10 max-w-3xl">
                <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
                    {title}
                </h1>
                <p class="mt-4 text-lg text-muted-foreground">{description}</p>
                <p class="mt-3 text-sm text-muted-foreground">
                    Renders come from the screenshot-test harness: the map is a
                    still image, the glass blur is left out, and fonts fall back
                    to the system face. The page URL reflects your selection, so
                    you can share a combination as a link. The Stable build
                    shows the latest release; the Nightly build shows the latest
                    nightly build, when one is available.
                </p>
            </header>
            <CatalogViewer
                client:load
                channels={[
                    {
                        id: "stable",
                        label: "Stable",
                        manifestUrl: withBase("/catalog/manifest.json"),
                        assetBase: withBase("/catalog/"),
                    },
                    {
                        id: "nightly",
                        label: "Nightly",
                        manifestUrl: withBase("/catalog/nightly/manifest.json"),
                        assetBase: withBase("/catalog/nightly/"),
                    },
                ]}
            />
        </Container>
    </main>
    <Footer />
</BaseLayout>
