---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/common/Header.astro";
import Footer from "@/components/common/Footer.astro";
import GlassPanel from "@/components/common/GlassPanel.astro";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import GlassCard from "@/components/ui/GlassCard.astro";
import Picture from "@/components/ui/Picture.astro";
import Section from "@/components/ui/Section.astro";
import { withBase } from "@/lib/url";
import siteConfig from "@/site.config";
// The committed screenshot-test goldens are the canonical dashboard look,
// regenerated by CI on every UI change, so the hero can never drift from the
// build. Imported in place — never copied into docs/.
import dashboardLight from "../../../app/src/test/screenshots/dashboard-head-unit-853x512.png";
import dashboardDark from "../../../app/src/test/screenshots/dashboard-head-unit-853x512-dark.png";

const features = (await getCollection("features")).toSorted(
    (a, b) => a.data.order - b.data.order,
);

const deviceClasses = [
    {
        title: "Aftermarket AI boxes",
        description:
            "Boxes that inject Android into a factory display through the car's CarPlay or Android Auto input. The launcher starts through the box's own boot-up hook.",
    },
    {
        title: "Android head units",
        description:
            "Aftermarket units running Android, landscape or portrait, at low pixel density and large dp footprints — from the 800×480 floor to 2000×1200 panels.",
    },
    {
        title: "Car-mounted phones",
        description:
            "A smartphone in a dashboard mount. The launcher also runs as a regular app there; making it the home screen stays optional.",
    },
];
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
    <Header />

    <main id="main" tabindex="-1">
        <section class="hero">
            <Container size="xl">
                <div class="hero__grid">
                    <div class="hero__copy">
                        <p class="hero__eyebrow">
                            Android 13+ · open source · no account
                        </p>
                        <h1>A glanceable home screen for the car.</h1>
                        <p class="hero__lede">
                            Femto Car Launcher replaces the Android home screen
                            with one fixed dashboard sized for automotive
                            viewing distances and touch accuracy: a live map,
                            driving data, weather, calendar and media on a
                            single screen, so the essentials are read at a
                            glance instead of found between apps.
                        </p>
                        <div class="hero__actions">
                            <Button
                                href={siteConfig.nightlyRelease}
                                variant="solid"
                                size="lg"
                            >
                                Download the nightly APK
                            </Button>
                            <Button href="/install/" variant="glass" size="lg">
                                Install guide
                            </Button>
                        </div>
                    </div>
                    <GlassPanel
                        variant="minimal"
                        padding="sm"
                        radius="xl"
                        className="hero__shot"
                    >
                        <div class="hero__shot--light">
                            <Picture
                                src={dashboardLight}
                                alt="The dashboard on a head-unit display in the light theme: a map with the self-marker, clock, calendar and weather cards, media controls, trip readout and the dock"
                                widths={[853]}
                                loading="eager"
                                fetchpriority="high"
                            />
                        </div>
                        <div class="hero__shot--dark">
                            <Picture
                                src={dashboardDark}
                                alt="The same dashboard in the dark theme, with the map switched to its dark style"
                                widths={[853]}
                                loading="eager"
                            />
                        </div>
                    </GlassPanel>
                </div>
            </Container>
        </section>

        <Section
            eyebrow="Three device classes"
            title="One launcher, wherever Android reaches the dashboard."
            subtitle="No single market is privileged: language, units and locale-specific behaviour adapt per device."
        >
            <div class="cards cards--3">
                {deviceClasses.map((device) => (
                    <GlassCard padding="lg">
                        <h3>{device.title}</h3>
                        <p>{device.description}</p>
                    </GlassCard>
                ))}
            </div>
        </Section>

        <Section
            eyebrow="Features"
            title="Everything the driver needs, nothing that competes for attention."
            subtitle="Each area has its own page with the details, the settings behind it, and what happens when a permission or a data source is missing."
        >
            <div class="cards cards--3">
                {features.map((feature) => (
                    <GlassCard
                        href={withBase(`/features/${feature.id}/`)}
                        padding="lg"
                    >
                        <h3>{feature.data.title}</h3>
                        <p>{feature.data.summary}</p>
                        <span class="card-link" aria-hidden="true">
                            Read more →
                        </span>
                    </GlassCard>
                ))}
            </div>
        </Section>

        <Section
            eyebrow="Screenshot catalog"
            title="Every screen size, every setting, side by side."
            subtitle="Every display geometry × display size × light and dark × left- and right-hand drive × dock position, regenerated from the current code on every change."
            container="md"
        >
            <div class="cta-row">
                <Button href="/catalog/" variant="solid" size="lg">
                    Browse the catalog
                </Button>
            </div>
        </Section>

        <Section
            eyebrow="Get it"
            title="Sideload the nightly, make it home."
            subtitle="Every merge to main publishes a release-signed APK. Android 13 or later is required."
            container="md"
        >
            <div class="cta-row">
                <Button
                    href={siteConfig.nightlyRelease}
                    variant="solid"
                    size="lg"
                >
                    Download the nightly APK
                </Button>
                <Button href="/install/" variant="glass" size="lg">
                    Read the install guide
                </Button>
                <Button href={siteConfig.repository} variant="ghost" size="lg">
                    Source on GitHub
                </Button>
            </div>
        </Section>
    </main>

    <Footer />
</BaseLayout>

<style>
    .hero {
        padding: var(--space-3xl) 0;
    }
    .hero__grid {
        display: grid;
        gap: var(--space-2xl);
        align-items: center;
    }
    @media (min-width: 1024px) {
        .hero__grid {
            grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
        }
    }
    .hero__eyebrow {
        margin: 0 0 var(--space-md);
        font-size: var(--text-sm);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-accent-text);
    }
    .hero h1 {
        font-size: var(--text-5xl);
        line-height: 1.05;
        margin: 0 0 var(--space-lg);
    }
    .hero__lede {
        font-size: var(--text-lg);
        color: var(--color-text-muted);
        margin: 0 0 var(--space-xl);
    }
    .hero__actions,
    .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-md);
    }
    .cta-row {
        justify-content: center;
    }
    /* One screenshot at a time: the golden that matches the page theme. */
    .hero__shot :global(img) {
        display: block;
        width: 100%;
        height: auto;
        border-radius: var(--radius-lg);
    }
    .hero__shot--dark {
        display: none;
    }
    :global([data-theme="dark"]) .hero__shot--light {
        display: none;
    }
    :global([data-theme="dark"]) .hero__shot--dark {
        display: block;
    }
    .cards {
        display: grid;
        gap: var(--space-lg);
    }
    @media (min-width: 768px) {
        .cards--3 {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
    .cards h3 {
        margin: 0 0 var(--space-sm);
        font-size: var(--text-xl);
    }
    .cards p {
        margin: 0;
        color: var(--color-text-muted);
    }
    .card-link {
        display: inline-block;
        margin-top: var(--space-md);
        color: var(--color-accent-text);
        font-weight: 600;
    }
</style>
