---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/common/Header.astro";
import Footer from "@/components/common/Footer.astro";
import Button from "@/components/ui/Button.astro";
import Card from "@/components/ui/Card.astro";
import Container from "@/components/ui/Container.astro";
import Picture from "@/components/ui/Picture.astro";
import Section from "@/components/ui/Section.astro";
import siteConfig from "@/site.config";
// The committed screenshot-test goldens are the canonical dashboard look; CI
// verifies them against the code on every pull request, so the hero matches
// the build. Imported in place — never copied into docs/.
import dashboardLight from "../../../app/src/test/screenshots/dashboard-head-unit-853x512.png";
import dashboardDark from "../../../app/src/test/screenshots/dashboard-head-unit-853x512-dark.png";

const features = (await getCollection("features")).toSorted(
    (a, b) => a.data.order - b.data.order,
);

const deviceClasses = [
    {
        title: "Aftermarket AI boxes",
        description:
            "Boxes that inject Android into a factory display through the car's CarPlay or Android Auto input. The launcher starts through the box's own boot-up app setting.",
    },
    {
        title: "Android head units",
        description:
            "Aftermarket units installed in the dashboard and running Android, in landscape or portrait, from 800×480 to 2000×1200 density-independent pixels (dp).",
    },
    {
        title: "Car-mounted phones",
        description:
            "A smartphone in a dashboard mount. The launcher also runs as a regular app there; making it the home screen stays optional.",
    },
];
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
    <Header />

    <main id="main" tabindex="-1">
        <section class="py-16 sm:py-24">
            <Container size="xl">
                <div class="grid items-center gap-12 lg:grid-cols-[5fr_6fr]">
                    <div>
                        <p class="text-sm font-medium tracking-wide text-primary uppercase">
                            Android 13+ · open source · no account
                        </p>
                        <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
                            A glanceable home screen for the car
                        </h1>
                        <p class="mt-5 text-lg text-muted-foreground">
                            Femto Car Launcher replaces the Android home screen
                            with one fixed dashboard sized for automotive
                            viewing distances and touch accuracy: a live map,
                            driving data, weather, calendar and media on a
                            single screen, so you read the essentials at a
                            glance instead of switching between apps.
                        </p>
                        <div class="mt-8 flex flex-wrap gap-3">
                            <Button
                                href={siteConfig.stableRelease}
                                variant="solid"
                                size="lg"
                            >
                                Download the stable APK
                            </Button>
                            <Button
                                href="/install/"
                                variant="outline"
                                size="lg"
                            >
                                Install guide
                            </Button>
                        </div>
                    </div>
                    <Card padding="md" class="overflow-hidden">
                        <div class="dark:hidden">
                            <Picture
                                src={dashboardLight}
                                alt="The dashboard on a head-unit display in the light theme: a map with the vehicle position marker, clock, calendar and weather cards, media controls, trip readout and the dock"
                                widths={[853]}
                                loading="eager"
                                fetchpriority="high"
                            />
                        </div>
                        <div class="hidden dark:block">
                            {/* Only one of the two hero images is ever displayed
                                (dark:hidden / hidden dark:block above): the visible
                                one is fetched immediately either way, since a lazy
                                image already inside the viewport loads at once, but
                                an eager hidden image would cost a full download in
                                the theme that never shows it. Light stays eager +
                                high priority as the LCP candidate — light is the
                                default rendering when the OS preference is unknown,
                                so it must not be the one that's lazy. */}
                            <Picture
                                src={dashboardDark}
                                alt="The same dashboard in the dark theme, with the map switched to its dark style"
                                widths={[853]}
                                loading="lazy"
                            />
                        </div>
                    </Card>
                </div>
            </Container>
        </section>

        <Section
            eyebrow="Three device classes"
            title="One launcher for three kinds of in-car Android device"
            subtitle="No single market is privileged: language, units and locale-specific behavior adapt per device."
        >
            <div class="grid gap-6 md:grid-cols-3">
                {deviceClasses.map((device) => (
                    <Card padding="lg">
                        <h3 class="text-lg font-semibold">{device.title}</h3>
                        <p class="mt-2 text-sm text-muted-foreground">
                            {device.description}
                        </p>
                    </Card>
                ))}
            </div>
        </Section>

        <Section
            eyebrow="Features"
            title="The dashboard, area by area"
            subtitle="Each area has its own page with the details, the settings behind it, and what happens when a permission or a data source is missing."
        >
            <div class="grid gap-6 md:grid-cols-3">
                {features.map((feature) => (
                    <Card href={`/features/${feature.id}/`} padding="lg">
                        <h3 class="text-lg font-semibold">
                            {feature.data.title}
                        </h3>
                        <p class="mt-2 text-sm text-muted-foreground">
                            {feature.data.summary}
                        </p>
                        <span
                            class="mt-4 inline-block text-sm font-medium text-primary"
                            aria-hidden="true"
                        >
                            Read more →
                        </span>
                    </Card>
                ))}
            </div>
        </Section>

        <Section
            eyebrow="Screenshot catalog"
            title="The dashboard across sizes, themes and layouts"
            subtitle="Display geometry × display size × light and dark × left- and right-hand drive × dock position, rendered from the stable code on every site deploy, plus a set from the nightly build."
            container="md"
        >
            <div class="flex flex-wrap justify-center gap-3">
                <Button href="/catalog/" variant="solid" size="lg">
                    Browse the catalog
                </Button>
            </div>
        </Section>

        <Section
            eyebrow="Get it"
            title="Install the stable build"
            subtitle="Stable is a dated release that changes only when the maintainer promotes a build; the nightly build changes often and may break. Both ship as Android packages (APKs). Android 13 or later is required."
            container="md"
        >
            <div class="flex flex-wrap justify-center gap-3">
                <Button
                    href={siteConfig.stableRelease}
                    variant="solid"
                    size="lg"
                >
                    Download the stable APK
                </Button>
                <Button
                    href={siteConfig.nightlyRelease}
                    variant="outline"
                    size="lg"
                >
                    Download the nightly APK
                </Button>
                <Button href={siteConfig.repository} variant="ghost" size="lg">
                    Source on GitHub
                </Button>
            </div>
        </Section>
    </main>

    <Footer />
</BaseLayout>
