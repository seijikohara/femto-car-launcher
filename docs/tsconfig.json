{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    // ES2023 (not just ES2022) so `Array#toSorted()` type-checks under
    // `tsc --noEmit` / `astro check`. This config only selects which lib
    // types are in scope; nothing here ever emits. What ships to a browser
    // — including src/catalog/, the site's React island — is transpiled by
    // Vite/esbuild to their own default target ("baseline-widely-available"),
    // set independently of this file.
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["astro/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "scripts/**/*",
    "astro.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
