<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup / device-transfer rules (API 31+).
   Everything is backed up by default; location-related settings are excluded so
   they are never copied off-device. The DataStore preference files live under
   the "file" domain at datastore/<name>.preferences_pb.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/location_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/location_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
