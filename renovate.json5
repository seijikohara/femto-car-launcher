{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Shared policy: https://github.com/seijikohara/renovate-config
  extends: ["github>seijikohara/renovate-config:default.json5"],
  // Target develop, not main: every commit on main whose APK changed is a
  // stable release (AGENTS.md, Git conventions), so a dependency bump
  // landing there directly would ship as an immediate stable release
  // instead of riding the nightly channel first, same as any other change.
  baseBranchPatterns: ["develop"],
  packageRules: [
    {
      description: "Group the Gradle version catalog and wrapper",
      matchManagers: ["gradle", "gradle-wrapper"],
      groupName: "gradle",
    },
    {
      description: "Group the pnpm projects (webmap, docs)",
      matchManagers: ["npm"],
      groupName: "pnpm",
    },
    {
      // pnpm itself is pinned three times: the packageManager field of
      // webmap/ and docs/ (npm manager) and the node-gradle pnpmVersion in
      // app/build.gradle.kts (regex manager). Split across two branches, the
      // Gradle pin moved to 12.14.0 while both packageManager fields stayed on
      // 12.6.0. This rule comes after the pnpm group rule, so it takes over the
      // pnpm dependency from that group.
      description: "Update every pnpm pin in one PR so the pins cannot drift apart",
      matchDepNames: ["pnpm"],
      groupName: "pnpm package manager",
    },
    {
      // @astrojs/check, which runs `astro check`, supports TypeScript ^5 || ^6
      // only. webmap is not affected and stays on TypeScript 7.
      description: "Keep the docs site below TypeScript 7 until Astro supports it",
      matchFileNames: ["docs/package.json"],
      matchPackageNames: ["typescript"],
      allowedVersions: "<7",
    },
    {
      // Astro renders Markdown with the satteri copy that
      // @astrojs/markdown-satteri depends on (^0.10.5 as of 0.4.6). The site's
      // own hast plugins import satteri types, so a second satteri minor makes
      // `astro check` reject them and could break them at runtime. Raise this
      // ceiling when @astrojs/markdown-satteri moves to a newer satteri.
      description: "Keep satteri on the minor that @astrojs/markdown-satteri uses",
      matchFileNames: ["docs/package.json"],
      matchPackageNames: ["satteri"],
      allowedVersions: "<0.11",
    },
  ],
  customManagers: [
    {
      customType: "regex",
      description: "Node / pnpm pins in the node-gradle block, annotated with renovate comments",
      managerFilePatterns: ["/(^|/)build\\.gradle\\.kts$/"],
      matchStrings: [
        "// renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s*\\n\\s*\\w+ = \"(?<currentValue>[^\"]+)\"",
      ],
    },
  ],
}
