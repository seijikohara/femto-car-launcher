{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Read(./local.properties)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/google-services.json)"
    ]
  },
  "attribution": { "commit": "", "pr": "", "sessionUrl": false }
}
